# Server
PORT=4000
FRONTEND_URL=http://localhost:5173
# Proxy hops in front of the API (Render: 1). Set it there so rate limits key on the
# real client IP instead of the proxy.
TRUST_PROXY=

# Supabase (service role key: server only, never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo (Phase 3)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Gmail SMTP for order and reset emails
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
